      "name": "HTTP Request1"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst query = data.embeddings?.[0];\n\nif (!Array.isArray(query) || query.length !== 768) {\n  throw new Error(\n    `Embedding skal indeholde 768 tal, men modtog ${\n      Array.isArray(query) ? query.length : 'ingen vektor'\n    }. Kontrollér Ollama-outputtet.`\n  );\n}\n\nreturn [{\n  json: {\n    k: 5,\n    embedding: query\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
