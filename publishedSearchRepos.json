        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  statement: \"CALL db.index.vector.queryNodes('repository_embedding_index', $k, $embedding) YIELD node, score RETURN node.name AS name, node.description AS description, node.languages AS languages, score ORDER BY score DESC\",\n  parameters: {\n    k: $json.k,\n    embedding: $json.embedding\n  }\n}) }}",
