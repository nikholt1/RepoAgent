      "id": "89b4cdd5-8be7-4132-b891-d639348f284d",
      "name": "HTTP Request2"
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst data = response.body?.data ?? response.data;\n\nif (!data?.fields || !data?.values) {\n  throw new Error(\n    'Neo4j response mangler data.fields eller data.values'\n  );\n}\n\nconst fields = data.fields;\nconst repositories = data.values.map(row =>\n  Object.fromEntries(\n    fields.map((field, index) => [field, row[index]])\n  )\n);\n\nreturn [\n  {\n    json: {\n      count: repositories.length,\n      repositories\n    }\n  }\n];"
      },
